config_version=5

[application]

config/name="Wizards Only Fools Current Version"
run/main_scene="res://boot_splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/enable_input=true

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
WorldHistory="*res://systems/world_history.gd"
CosmologyFactions="*res://systems/cosmology_factions.gd"
Interstitial="*res://systems/interstitial.gd"
PauseGate="*res://systems/pause_gate.gd"
PerfProbe="*res://systems/perf_probe.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/wizards.log"
file_logging/max_log_files=8

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/proton_scatter/plugin.cfg")

